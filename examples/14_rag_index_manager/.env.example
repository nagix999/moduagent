# Copy this file to the repository root as .env, then edit the four required
# vLLM values. Existing shell environment variables take precedence.

# Required: Gemma management, text enrichment, and page-layout VLM endpoint.
RAG_VLLM_BASE_URL=http://127.0.0.1:8000/v1
RAG_TEXT_MODEL=google/gemma-4-26B-A4B-it
# RAG_VLLM_API_KEY=
# RAG_VLLM_API_KEY_FILE=/run/secrets/gemma-api-key

# Required: BGE-M3 OpenAI-compatible embedding endpoint.
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_API_KEY_FILE=/run/secrets/embedding-api-key

# The bundled Compose file provides these local services.
DOCLING_SERVE_URL=http://127.0.0.1:5001
DOCLING_SERVE_REVISION=docling-serve-v1.21.0
DOCLING_SERVE_DO_OCR=false
# Optional but recommended for PPT/DOC layout refinement when Docling omits
# whole-page images. Requires local `soffice` and `pdftocairo` executables.
RAG_OFFICE_PAGE_CAPTURE=true
RAG_MILVUS_URI=http://127.0.0.1:19530

# Local corpus and resumable state.
RAG_SAMPLE_CORPUS_ROOT=examples/14_rag_index_manager/.runtime/nist-cybersecurity
RAG_SAMPLE_DOCUMENT_COUNT=100
RAG_DOCUMENT_ROOT=examples/14_rag_index_manager/.runtime/nist-cybersecurity/documents
RAG_STATE_DIR=examples/14_rag_index_manager/.runtime/state
RAG_KB_ID=nist-cybersecurity

# Human-friendly progress by default; use json for a log collector.
RAG_LOG_FORMAT=pretty
RAG_LOG_LANGUAGE=ko

# Continuous ingestion. The watcher applies stable changes without an LLM
# decision; the management Agent remains available for status/rebuild/rollback.
RAG_WATCH_POLL_SECONDS=5
RAG_WATCH_STABILITY_SECONDS=15
RAG_WATCH_RECONCILE_SECONDS=300
RAG_WATCH_MAX_ATTEMPTS=5
RAG_WATCH_RETRY_INITIAL_SECONDS=5
RAG_WATCH_RETRY_MAX_SECONDS=300

# Optional image overrides for Docker Compose.
DOCLING_SERVE_IMAGE=quay.io/docling-project/docling-serve-cpu:v1.21.0
RAG_MILVUS_IMAGE=milvusdb/milvus:v2.5.27
